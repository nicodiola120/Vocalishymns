{
  "name": "vocalis",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "publish": "powershell -ExecutionPolicy Bypass -File publish-update.ps1 -Version",
    "electron:start": "vite build && electron electron-main.cjs",
    "electron:build": "vite build && electron-builder --win",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "vite build && npx cap open android",
    "android:build": "vite build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "voucher": "node scripts/generate-voucher.cjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capawesome/capacitor-file-picker": "^8.0.3",
    "@capawesome/capacitor-live-update": "^8.3.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zip.js/zip.js": "^2.8.31",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "main": "electron-main.cjs",
  "description": "Choralis - Choir Voice Mixer",
  "author": "Nicolas Diola",
  "build": {
    "appId": "com.choralis.app",
    "productName": "Choralis",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
